<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.tabpat.dao.UserRoleDao">
    <select id="selectByUserId" resultType="UserRoleDo">
        SELECT
            user_id,
            role_id
        FROM user_role
        WHERE user_id = #{userId};
    </select>

    <insert id="insert" parameterType="UserRoleDo" useGeneratedKeys="true" keyProperty="userId">
        INSERT INTO user_role(user_id,
                              role_id)
        VALUES (#{userId},
                #{roleId})
    </insert>

    <insert id="insertBatch" parameterType="UserRoleDo">
        INSERT INTO user_role (
                               user_id,
                               role_id)
        VALUES
        <foreach collection="userRoleDoList" item="item" separator=",">
            (#{item.userId}, #{item.roleId})
        </foreach>
    </insert>

    <delete id="remove" parameterType="UserRoleDo">
        DELETE
        FROM user_role
        WHERE
        user_id = #{userId}
    </delete>


</mapper>