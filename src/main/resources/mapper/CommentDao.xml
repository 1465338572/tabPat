<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.tabpat.dao.CommentDao">

    <select id="selectList" resultType="com.example.tabpat.domain.CommentDo">
        SELECT *
        FROM comment ${ew.customSqlSegment}
    </select>

    <select id="getCommentByCommentId" resultType="com.example.tabpat.domain.CommentDo">
        SELECT *
        FROM comment
        WHERE comment_id = #{ commentId }
    </select>

    <insert id="insert" parameterType="com.example.tabpat.domain.CommentDo" useGeneratedKeys="true"
            keyProperty="articleId">
        INSERT INTO comment(comment_id,
                            content,
                            create_time,
                            is_delete,
                            username,
                            article_id,
                            comment_like_count,
                            root_comment_id,
                            to_comment_id)
        VALUES (#{commentId},
                #{content},
                #{createTime},
                #{isDelete},
                #{username},
                #{articleId},
                #{commentLikeCount},
                #{rootCommentId},
                #{toCommentId})
    </insert>

    <update id="updateById" parameterType="com.example.tabpat.domain.CommentDo">
        UPDATE comment
        <set>
            <if test="et.isDelete!=null">
                is_delete = #{et.isDelete}
            </if>
        </set>
        WHERE comment_id = #{et.commentId}
    </update>
</mapper>