<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.tabpat.dao.AppDao">

    <select id="selectList" resultType="AppDo">
        SELECT *
        FROM apps
    </select>

    <select id="selectByAppId" resultType="AppDo">
        SELECT id,
               name,
               type,
               code,
               icon,
               pid,
               path,
               pos
        FROM apps
        WHERE id = #{appId};
    </select>
</mapper>