<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.tabpat.dao.RolePermissionDao">

    <select id="selectList" resultType="RolePermissionDo">
        SELECT role_id,
               permission_id
        FROM role_permission ${ew.customSqlSegment}
    </select>

    <select id="getRolePermissionByRoleId" resultType="RolePermissionDo">
        SELECT role_id,
               permission_id
        FROM role_permission
        WHERE role_id = #{roleId};
    </select>

    <select id="getRolePermissionByPermissionId" resultType="RolePermissionDo">
        SELECT role_id,
               permission_id
        FROM role_permission
        WHERE permission_id = #{permissionId};
    </select>

    <insert id="insert" parameterType="RolePermissionDo">
        INSERT INTO role_permission(role_id,
                                    permission_id)
        VALUES (#{roleId},
                #{permissionId})
    </insert>

    <delete id="deleteRolePermission" parameterType="RolePermissionDo">
        DELETE
        FROM role_permission
        <where>
            1=1
            <if test="roleId != null">
                AND role_id = #{roleId}
            </if>
            <if test="permissionId != null">
                AND permission_id = #{permissionId}
            </if>
        </where>
    </delete>
</mapper>